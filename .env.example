# Morrow environment template. Copy to .env and fill in locally. Never commit .env.

# --- Supabase / PostgreSQL (canonical state) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Hermes agent runtime (orchestration, scheduling, model routing) ---
HERMES_API_URL=
HERMES_API_KEY=

# --- Telegram (observation ingestion + micro-question / approval UX) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Model routing (Hermes-managed) ---
MODEL_PROVIDER_API_KEY=
MODEL_ROUTER_DEFAULT=

# --- Morrow Memory Repo (Git + Markdown) ---
MORROW_MEMORY_REPO_PATH=./memory_repo
MORROW_MEMORY_GIT_REMOTE=

# --- Observability (neatlogs) ---
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=
MORROW_LOG_LEVEL=INFO

# --- Evaluation (Inspect AI) ---
INSPECT_LOG_DIR=./eval/reports
MORROW_EVAL_HOLDOUT_ENABLED=true

# --- Economics model (cfo.ai) ---
CFOAI_API_KEY=

# --- Development provenance (Entire) ---
ENTIRE_API_KEY=

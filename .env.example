# Serene environment template.
# Copy to .env (gitignored) and fill in locally. Never commit .env or real values.
# Every variable read by code under serene/, scripts/ or eval/ must be listed here
# (enforced by tests/test_repo_hygiene.py). Secrets stay empty in this file.

# --- Supabase / PostgreSQL (canonical state: serene.domain_events) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by serene.adapters.postgres (service role).
SUPABASE_DB_URL=
# Optional: real Postgres for the test suite. If empty, tests start a local
# PostgreSQL via pgserver (no Docker needed). CI sets this to a service container.
SERENE_TEST_DATABASE_URL=

# --- Hermes Agent runtime (reasoning, tools, Telegram gateway, browser) ---
# Hermes keeps its own config and secrets (model keys, TELEGRAM_BOT_TOKEN) in
# HERMES_HOME/.env. Leave empty to use the default (%LOCALAPPDATA%\hermes or ~/.hermes).
HERMES_HOME=
# Pinned Hermes release used by scripts/bootstrap.* (tag v2026.9.24).
HERMES_PINNED_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f

# --- Telegram (observation ingestion + approval UX, through the Hermes gateway) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Model routing (Hermes-managed) ---
MODEL_PROVIDER_API_KEY=
MODEL_ROUTER_DEFAULT=

# --- Serene Memory Repo (Git + Markdown) ---
SERENE_MEMORY_REPO_PATH=./memory_repo

# --- Observability (neatlogs) ---
# Without NEATLOGS_API_KEY telemetry is a no-op. Telemetry never gates correctness.
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=
# Keyed pseudonym for child ids in telemetry. Empty => child ids are dropped.
SERENE_TELEMETRY_PSEUDONYM_KEY=

# --- Evaluation (Inspect AI) ---
INSPECT_LOG_DIR=./eval/reports/local

# --- cfo.ai economics model ---
# No key: cfo.ai is a remote MCP server (https://api.cfo.ai/mcp) registered in
# .mcp.json and authenticated in the browser. See docs/setup.md.

# --- Entire development provenance ---
# No key in the repo: run `entire login` locally. See docs/setup.md.

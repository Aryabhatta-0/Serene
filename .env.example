# Serene environment template.
# Copy to .env (gitignored) and fill in locally. Never commit .env or real values.
# Operator variables across Python, web, shell and Supabase are audited by
# scripts/env_audit.py. Internal/OS/test flags are explicitly classified there.
# Secrets stay empty. Configure only the optional integrations you use.

# --- Supabase / PostgreSQL (canonical state: serene.domain_events) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by serene.adapters.postgres (service role).
SUPABASE_DB_URL=
# Web app (app/web, issue #33): the same project's URL and anon key, exposed to
# the browser. Both are public by design: RLS decides what a signed-in user can
# read. Leave empty and every surface stays "not connected".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local canonical Maya recording only. Set 1 on the Next.js server to enable
# /demo/maya; keep 0 for production. No authentication or approval transport.
SERENE_DEMO_MODE=0
# Web approval decisions (issue #84). Server-side only, never NEXT_PUBLIC_.
# The web app's /api/approvals forwards to this kernel endpoint
# (app/approvals/approvals_server.py), e.g. http://127.0.0.1:8788.
SERENE_KERNEL_URL=
# The kernel endpoint accepts browser Origins from this comma-separated list.
SERENE_WEB_ORIGINS=
# JSON list binding a Supabase user, for one child, to the opaque PARENT actor
# approval requests are addressed to, e.g.
# [{"user_id": "<auth user uuid>", "child_id": "chd_...", "actor": {"kind": "PARENT", "actor_id": "act_..."}}]
# The user must also be that child's PARENT in serene.child_guardians.
SERENE_WEB_BINDINGS=
# Optional: real Postgres for the test suite. If empty, tests start a local
# PostgreSQL via pgserver (no Docker needed). CI sets this to a service container.
SERENE_TEST_DATABASE_URL=
# Local browser test iteration only: reuse the approval lane's existing build.
# CI and clean verification always leave this empty and rebuild.
SERENE_E2E_SKIP_BUILD=

# --- Hermes Agent runtime (reasoning, tools, Telegram gateway, browser) ---
# Hermes keeps its own config and secrets (model keys, TELEGRAM_BOT_TOKEN) in
# HERMES_HOME/.env. Leave empty to use the default (%LOCALAPPDATA%\hermes or ~/.hermes).
HERMES_HOME=
# Pinned Hermes release used by scripts/bootstrap.* (tag v2026.9.24).
HERMES_PINNED_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f
# Hermes OpenAI-compatible API server used by serene.adapters.hermes (branch A).
# Loopback http or https only; the key is Hermes' API_SERVER_KEY. Empty => the
# Hermes runtime/browser adapters fail closed and propose nothing.
HERMES_API_BASE_URL=
HERMES_API_SERVER_KEY=

# --- Telegram (observation ingestion + approval UX, through the Hermes gateway) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# JSON list binding Telegram user ids to Serene principals, e.g.
# [{"telegram_user_id": 1, "child_id": "chd_...", "actor": {"kind": "PARENT", "actor_id": "act_..."}}]
SERENE_TELEGRAM_BINDINGS=
# Comma-separated domains the evidence browser may visit (e.g. example.org).
SERENE_BROWSER_ALLOWED_DOMAINS=

# --- Model routing (Hermes-managed) ---
MODEL_PROVIDER_API_KEY=
MODEL_ROUTER_DEFAULT=

# --- Serene Memory Repo (Git + Markdown) ---
# Live projection publisher: root containing one Git repo per <child_id>.
# Each child's committer must use the same repo. See docs/memory-publication.md.
SERENE_MEMORY_REPO_PATH=./memory_repo

# --- Observability (neatlogs) ---
# Without NEATLOGS_API_KEY telemetry is a no-op. Telemetry never gates correctness.
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=
NEATLOGS_SESSION_ID=
NEATLOGS_END_USER_ID=
# Keyed pseudonym for child ids in telemetry. Empty => child ids are dropped.
SERENE_TELEMETRY_PSEUDONYM_KEY=
# OpenTelemetry resource attributes (e.g. for verification markers)
OTEL_RESOURCE_ATTRIBUTES=

# --- Evaluation (Inspect AI) ---
INSPECT_LOG_DIR=./eval/reports/local
# Optional frozen live-gate provider credential; never required for offline tests.
OPENCODE_GO_API_KEY=

# --- Optional Supabase local tooling (disabled integrations in config.toml) ---
# Studio AI, S3, email, SMS and Apple OAuth respectively. Leave empty unless enabled.
OPENAI_API_KEY=
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENDGRID_API_KEY=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- cfo.ai economics model ---
# No key: cfo.ai is a remote MCP server (https://api.cfo.ai/mcp) registered in
# .mcp.json and authenticated in the browser. See docs/setup.md.

# --- Entire development provenance ---
# No key in the repo: run `entire login` locally. See docs/setup.md.
